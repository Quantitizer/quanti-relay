# Copy to .env (never committed) and fill in. docker compose passes these to the relay as
# environment variables. Leave a line empty to leave it unset.

# Required: the key the console and the API ask for (a random string of at least 32 characters, e.g. from
#   python -c "import secrets; print(secrets.token_urlsafe(32))")
RELAY_API_KEY=
# Optional: a second key that can only read (GET), never act.
RELAY_API_READONLY_KEY=

# Reachable from the internet (all optional; docs/SPEC.md §4):
# Behind a TLS proxy you run: its address or network, so the relay sees each client's real address.
# RELAY_TRUSTED_PROXIES=
# RELAY_CLIENT_IP_HEADER=X-Forwarded-For
# Only these addresses or networks may use the API and the console (signal intake is not affected).
# RELAY_API_ALLOW_IPS=
# A monitoring service's heartbeat URL: called while the relay is healthy, so silence raises an alert.
# RELAY_HEARTBEAT_URL=
# The MCP endpoint for chat apps (https://<address>/mcp), signed in on the relay's own page.
# RELAY_MCP_ENABLED=false
# Written by deploy/install.sh: the relay's address and the server's public IP.
# RELAY_PUBLIC_HOST=
# RELAY_PUBLIC_IP=

# With the postgres profile only (docker compose --profile postgres up -d):
# POSTGRES_PASSWORD=
# RELAY_DATABASE_URL=postgresql+asyncpg://relay:<the same password>@postgres/relay

# Paper trading (dry-run) stays on here AND in the deployment file until you decide otherwise.
RELAY_DRY_RUN=true

# Secrets your source and sink files name (secret_env:, *_env:), e.g.
# RELAY_SOURCE_MYBOT_SECRET=
# RELAY_TELEGRAM_BOT_TOKEN=
# RELAY_TELEGRAM_CHAT_ID=

# Native Bybit: its keys, and which Bybit host (testnet unless you say demo, or both false = live).
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# RELAY_BYBIT_DEMO=
# RELAY_TESTNET=

# Any other exchange: keys named after it (docs/venues.md). Trade-only keys, never withdrawal. E.g.
# RELAY_OKX_API_KEY=
# RELAY_OKX_API_SECRET=
# RELAY_OKX_API_PASSPHRASE=
