#!/usr/bin/env bash
# The `relay` command on a server set up by deploy/install.sh. Run it with sudo.
#
#   relay doctor [--json] [--online]   check everything (inside the container)
#   relay setup ... / relay check-config / relay test-signal ...   the relay's own commands
#   relay secret set|generate|reveal|list NAME   secrets in .env, typed and shown at your terminal only
#   relay restart                      start the relay again with what .env says now
#   relay update [<version>] [--yes]   a new version (a database copy first; see update.sh)
#   relay logs                         follow the relay's log
#   relay status                       the containers
set -euo pipefail
[ -r /etc/default/quanti-relay ] && . /etc/default/quanti-relay
DIR="${RELAY_DIR:-/opt/quanti-relay}"
cd "$DIR"
COMPOSE=(docker compose --profile tls)   # a list, not a function: exec starts programs only

case "${1:-help}" in
  secret) shift; exec python3 -I "$DIR/relay/envfile.py" --env-file "$DIR/.env" "$@" ;;
  # A restart alone keeps the old environment: the container is made again so it reads .env.
  restart) exec "${COMPOSE[@]}" up -d --force-recreate relay ;;
  update) shift; exec "$DIR/deploy/update.sh" "$@" ;;
  logs) exec "${COMPOSE[@]}" logs --tail=200 -f relay ;;
  status) exec "${COMPOSE[@]}" ps ;;
  help|-h|--help) sed -n '2,11p' "$0" ;;
  *) exec "${COMPOSE[@]}" exec -T relay relay "$@" ;;
esac
